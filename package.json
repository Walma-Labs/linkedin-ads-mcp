{
  "name": "@walma-labs/linkedin-ads-mcp",
  "version": "0.2.0",
  "description": "LinkedIn Ads MCP server: campaigns, creatives, performance, period comparison and audience demographics from Campaign Manager. Read-only by default; draft-only campaign building is opt-in.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Walma-Labs/linkedin-ads-mcp.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "linkedin-ads-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
